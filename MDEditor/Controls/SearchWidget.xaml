<UserControl
    x:Class="MDEditor.Controls.SearchWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent" CornerRadius="8">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="FindPanelBackground" Color="#F3F3F3"/>
                    <SolidColorBrush x:Key="FindPanelBorder" Color="#C8C8C8"/>
                    <SolidColorBrush x:Key="FindInputBackground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="FindInputBorder" Color="#CECECE"/>
                    <SolidColorBrush x:Key="FindForeground" Color="#616161"/>
                    <SolidColorBrush x:Key="FindPlaceholder" Color="#767676"/>
                    <SolidColorBrush x:Key="FindFocusBorder" Color="#0090F1"/>
                    <SolidColorBrush x:Key="FindHoverBackground" Color="#14000000"/>
                    <SolidColorBrush x:Key="FindCheckedBackground" Color="#DAEBF6"/>
                    <SolidColorBrush x:Key="FindCheckedBorder" Color="#007ACC"/>
                    <SolidColorBrush x:Key="FindSelectionBackground" Color="#ADD6FF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="FindPanelBackground" Color="#252526"/>
                    <SolidColorBrush x:Key="FindPanelBorder" Color="#454545"/>
                    <SolidColorBrush x:Key="FindInputBackground" Color="#3C3C3C"/>
                    <SolidColorBrush x:Key="FindInputBorder" Color="#3C3C3C"/>
                    <SolidColorBrush x:Key="FindForeground" Color="#CCCCCC"/>
                    <SolidColorBrush x:Key="FindPlaceholder" Color="#A6A6A6"/>
                    <SolidColorBrush x:Key="FindFocusBorder" Color="#007FD4"/>
                    <SolidColorBrush x:Key="FindHoverBackground" Color="#1AFFFFFF"/>
                    <SolidColorBrush x:Key="FindCheckedBackground" Color="#094771"/>
                    <SolidColorBrush x:Key="FindCheckedBorder" Color="#007ACC"/>
                    <SolidColorBrush x:Key="FindSelectionBackground" Color="#264F78"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Only the chrome is custom: ContentElement remains a native TextBox/TSF editor. -->
            <Style x:Key="FindTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Padding" Value="5,0,5,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{ThemeResource FindForeground}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="SelectionHighlightColor" Value="{ThemeResource FindSelectionBackground}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid Background="{TemplateBinding Background}">
                                <Border x:Name="BorderElement" Background="{TemplateBinding Background}"
                                        Control.IsTemplateFocusTarget="True"/>
                                <ScrollViewer x:Name="ContentElement"
                                              Foreground="{TemplateBinding Foreground}"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsTabStop="False" ZoomMode="Disabled"
                                              AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock x:Name="PlaceholderTextContentPresenter"
                                           Text="{TemplateBinding PlaceholderText}"
                                           FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                           Foreground="{ThemeResource FindPlaceholder}"
                                           Padding="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FindIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{ThemeResource FindForeground}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="AllowFocusOnInteraction" Value="False"/>
                <Setter Property="UseSystemFocusVisuals" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters><Setter Target="ButtonChrome.Background" Value="{ThemeResource FindHoverBackground}"/></VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters><Setter Target="ButtonChrome.Background" Value="{ThemeResource FindHoverBackground}"/></VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters><Setter Target="ButtonChrome.Opacity" Value="0.4"/></VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="FocusStates">
                                        <VisualState x:Name="Unfocused"/>
                                        <VisualState x:Name="Focused">
                                            <VisualState.Setters><Setter Target="ButtonChrome.BorderBrush" Value="{ThemeResource FindFocusBorder}"/></VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerFocused"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FindOptionStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Foreground" Value="{ThemeResource FindForeground}"/>
                <Setter Property="AllowFocusOnInteraction" Value="False"/>
                <Setter Property="UseSystemFocusVisuals" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="OptionChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="OptionChrome.Background" Value="{ThemeResource FindHoverBackground}"/></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="OptionChrome.Background" Value="{ThemeResource FindHoverBackground}"/></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Checked"><VisualState.Setters>
                                            <Setter Target="OptionChrome.Background" Value="{ThemeResource FindCheckedBackground}"/>
                                            <Setter Target="OptionChrome.BorderBrush" Value="{ThemeResource FindCheckedBorder}"/>
                                        </VisualState.Setters></VisualState>
                                        <VisualState x:Name="CheckedPointerOver"><VisualState.Setters>
                                            <Setter Target="OptionChrome.Background" Value="{ThemeResource FindCheckedBackground}"/>
                                            <Setter Target="OptionChrome.BorderBrush" Value="{ThemeResource FindCheckedBorder}"/>
                                        </VisualState.Setters></VisualState>
                                        <VisualState x:Name="CheckedPressed"><VisualState.Setters>
                                            <Setter Target="OptionChrome.Background" Value="{ThemeResource FindCheckedBackground}"/>
                                            <Setter Target="OptionChrome.BorderBrush" Value="{ThemeResource FindCheckedBorder}"/>
                                        </VisualState.Setters></VisualState>
                                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="OptionChrome.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="FocusStates">
                                        <VisualState x:Name="Unfocused"/>
                                        <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="OptionChrome.BorderBrush" Value="{ThemeResource FindFocusBorder}"/></VisualState.Setters></VisualState>
                                        <VisualState x:Name="PointerFocused"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Only this rounded surface draws panel chrome and casts a shadow; the host is transparent. -->
    <Border x:Name="PanelChrome" Background="{ThemeResource FindPanelBackground}" BorderBrush="{ThemeResource FindPanelBorder}"
            BorderThickness="1" CornerRadius="8" Padding="4">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="FindFocusStates">
                <VisualState x:Name="FindUnfocused"/>
                <VisualState x:Name="FindFocused"><VisualState.Setters><Setter Target="FindChrome.BorderBrush" Value="{ThemeResource FindFocusBorder}"/></VisualState.Setters></VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="ReplaceFocusStates">
                <VisualState x:Name="ReplaceUnfocused"/>
                <VisualState x:Name="ReplaceFocused"><VisualState.Setters><Setter Target="ReplaceChrome.BorderBrush" Value="{ThemeResource FindFocusBorder}"/></VisualState.Setters></VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid ColumnSpacing="4">
            <Grid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="源码 / 实时预览（Ctrl+/）" Command="{Binding ToggleSourceCommand}"/>
                </MenuFlyout>
            </Grid.ContextFlyout>
            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="ReplaceExpander" Style="{StaticResource FindIconButtonStyle}"
                          Width="20" Height="Auto" VerticalAlignment="Stretch"
                          Click="ReplaceExpander_Click" ToolTipService.ToolTip="展开 / 收起替换（Ctrl+H）"
                          AutomationProperties.Name="展开替换">
                <Path x:Name="ReplaceChevron" Data="M 5.5,3 L 10.5,8 L 5.5,13" Width="16" Height="16"
                      Stroke="{ThemeResource FindForeground}" StrokeThickness="1" RenderTransformOrigin="0.5,0.5"/>
            </Button>
            <StackPanel Grid.Column="1" Spacing="4">
                <Grid ColumnSpacing="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="24"/><ColumnDefinition Width="24"/><ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="FindChrome" Height="26" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource FindInputBorder}" Background="{ThemeResource FindInputBackground}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="FindTextBox" Style="{StaticResource FindTextBoxStyle}" PlaceholderText="查找"
                                     Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     GotFocus="Input_FocusChanged" LostFocus="Input_FocusChanged" AutomationProperties.Name="查找"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,1,0">
                                <ToggleButton Style="{StaticResource FindOptionStyle}" IsChecked="{Binding MatchCase, Mode=TwoWay}" ToolTipService.ToolTip="区分大小写" AutomationProperties.Name="区分大小写"><TextBlock Text="Aa" FontFamily="Segoe UI" FontSize="12"/></ToggleButton>
                                <ToggleButton Style="{StaticResource FindOptionStyle}" IsChecked="{Binding WholeWord, Mode=TwoWay}" ToolTipService.ToolTip="整词匹配" AutomationProperties.Name="整词匹配"><TextBlock Text="ab" TextDecorations="Underline" FontFamily="Segoe UI" FontSize="12"/></ToggleButton>
                                <ToggleButton Style="{StaticResource FindOptionStyle}" IsChecked="{Binding RegularExpression, Mode=TwoWay}" ToolTipService.ToolTip="使用正则表达式" AutomationProperties.Name="使用正则表达式"><TextBlock Text=".*" FontFamily="Segoe UI" FontSize="14"/></ToggleButton>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="SearchStatus" Grid.Column="1" Foreground="{ThemeResource FindForeground}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,0,0"/>
                    <Button Grid.Column="2" Style="{StaticResource FindIconButtonStyle}" Command="{Binding PreviousCommand}" ToolTipService.ToolTip="上一个匹配项（Shift+F3）" AutomationProperties.Name="上一个匹配项"><Path Data="M 8,13 L 8,3 M 3,8 L 8,3 L 13,8" Width="16" Height="16" Stroke="{ThemeResource FindForeground}" StrokeThickness="1"/></Button>
                    <Button Grid.Column="3" Style="{StaticResource FindIconButtonStyle}" Command="{Binding NextCommand}" ToolTipService.ToolTip="下一个匹配项（F3）" AutomationProperties.Name="下一个匹配项"><Path Data="M 8,3 L 8,13 M 3,8 L 8,13 L 13,8" Width="16" Height="16" Stroke="{ThemeResource FindForeground}" StrokeThickness="1"/></Button>
                    <Button Grid.Column="4" Style="{StaticResource FindIconButtonStyle}" Command="{Binding CloseCommand}" ToolTipService.ToolTip="关闭（Esc）" AutomationProperties.Name="关闭搜索"><Path Data="M 3,3 L 13,13 M 13,3 L 3,13" Width="16" Height="16" Stroke="{ThemeResource FindForeground}" StrokeThickness="1"/></Button>
                </Grid>
                <Grid x:Name="ReplacementRow" Visibility="Collapsed" ColumnSpacing="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="24"/><ColumnDefinition Width="24"/><ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ReplaceChrome" Height="26" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource FindInputBorder}" Background="{ThemeResource FindInputBackground}">
                        <TextBox x:Name="ReplaceTextBox" Style="{StaticResource FindTextBoxStyle}" PlaceholderText="替换"
                                 Text="{Binding Replacement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 GotFocus="Input_FocusChanged" LostFocus="Input_FocusChanged" AutomationProperties.Name="替换"/>
                    </Border>
                    <!-- Microsoft Codicons replace/replace-all; SVG paths adapted to native XAML.
                         Attribution and CC BY 4.0 license: Assets/Codicons/NOTICE.txt. -->
                    <Button Grid.Column="2" Style="{StaticResource FindIconButtonStyle}" Command="{Binding ReplaceCommand}" ToolTipService.ToolTip="替换当前匹配项" AutomationProperties.Name="替换当前匹配项">
                        <Canvas Width="16" Height="16" IsHitTestVisible="False">
                            <Path Fill="{ThemeResource FindForeground}" Data="F0 M10 2.813C10.295 2.619 10.634 2.5 11 2.5C12.103 2.5 13 3.509 13 4.75C13 5.991 12.103 7 11 7C10.62 7 10.269 6.873 9.966 6.666C9.897 6.86 9.717 7 9.5 7C9.224 7 9 6.776 9 6.5V1.5C9 1.224 9.224 1 9.5 1C9.776 1 10 1.224 10 1.5V2.813ZM10 4.75C10 5.439 10.448 6 11 6C11.552 6 12 5.439 12 4.75C12 4.061 11.552 3.5 11 3.5C10.448 3.5 10 4.061 10 4.75Z"/>
                            <Path Fill="{ThemeResource FindForeground}" Data="F0 M2 9H7C7.552 9 8 9.448 8 10V15C8 15.552 7.552 16 7 16H2C1.448 16 1 15.552 1 15V10C1 9.448 1.448 9 2 9ZM5.039 13.645C4.81 13.849 4.199 13.968 3.83 13.506C3.617 13.24 3.5 12.88 3.5 12.492C3.5 12.104 3.618 11.744 3.83 11.478C4.201 11.014 4.811 11.133 5.04 11.339C5.244 11.525 5.56 11.507 5.746 11.303C5.931 11.098 5.915 10.782 5.709 10.597C4.922 9.887 3.733 10.001 3.049 10.853C2.695 11.297 2.5 11.878 2.5 12.492C2.5 13.106 2.695 13.688 3.049 14.131C3.43 14.605 3.945 14.867 4.5 14.867C4.941 14.867 5.359 14.701 5.708 14.387C5.913 14.202 5.93 13.886 5.745 13.681C5.559 13.476 5.243 13.458 5.039 13.645Z"/>
                            <Path Fill="{ThemeResource FindForeground}" Data="F1 M3.99998 4.5C3.99998 3.673 4.67298 3 5.49998 3H7.50198C7.77798 3 8.00198 3.224 8.00198 3.5C8.00198 3.776 7.77798 4 7.50198 4H5.50198C5.22598 4 5.00198 4.225 5.00198 4.5V6.293L6.14798 5.147C6.34298 4.952 6.65998 4.952 6.85498 5.147C7.04998 5.342 7.04998 5.659 6.85498 5.854L4.85498 7.854C4.75698 7.951 4.62898 8 4.50098 8C4.37298 8 4.24498 7.952 4.14698 7.854L2.14698 5.854C1.95198 5.659 1.95198 5.342 2.14698 5.147C2.34198 4.952 2.65898 4.952 2.85398 5.147L3.99998 6.293V4.5Z"/>
                        </Canvas>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource FindIconButtonStyle}" Command="{Binding ReplaceAllCommand}" ToolTipService.ToolTip="全部替换" AutomationProperties.Name="全部替换">
                        <Canvas Width="16" Height="16" IsHitTestVisible="False">
                            <Path Fill="{ThemeResource FindForeground}" Data="F1 M14 13V10C14 8.35 12.65 7 11 7H5.12L4.12 8H11C12.1 8 13 8.9 13 10V14C13.55 14 14 13.55 14 13Z"/>
                            <Path Fill="{ThemeResource FindForeground}" Data="F0 M10.999 5.5V2.75C10.999 1.765 10.12 1.25 9.25 1.25C8.362 1.25 7.989 1.553 7.896 1.646C7.701 1.841 7.687 2.17 7.882 2.365C8.076 2.561 8.379 2.573 8.575 2.378C8.57462 2.37825 8.57506 2.37797 8.575 2.378C8.58734 2.36997 8.77165 2.25 9.249 2.25C9.279 2.25 9.999 2.256 9.999 2.75V3.056C9.795 3.023 9.551 3 9.249 3C7.936 3 7.249 3.754 7.249 4.5C7.249 5.246 7.936 6 9.249 6C9.621 6 9.91 5.937 10.144 5.851C10.235 5.943 10.36 6 10.499 6C10.775 6 10.999 5.776 10.999 5.5ZM9.25 4C9.622 4 9.856 4.038 10 4.074V4.811C9.907 4.885 9.697 5 9.25 5C8.601 5 8.25 4.742 8.25 4.5C8.25 4.258 8.601 4 9.25 4Z"/>
                            <Path Fill="{ThemeResource FindForeground}" Data="F1 M5.001 13.074C4.857 13.038 4.623 13 4.251 13C3.602 13 3.251 13.258 3.251 13.5C3.251 13.742 3.602 14 4.251 14C4.698 14 4.908 13.885 5.001 13.811V13.074Z"/>
                            <Path Fill="{ThemeResource FindForeground}" Data="F0 M12 15V10C12 9.448 11.552 9 11 9H2C1.448 9 1 9.448 1 10V15C1 15.552 1.448 16 2 16H11C11.552 16 12 15.552 12 15ZM4.251 10.25C5.121 10.25 6 10.765 6 11.75V14.5C6 14.776 5.776 15 5.5 15C5.361 15 5.236 14.943 5.145 14.851C4.911 14.937 4.622 15 4.25 15C2.937 15 2.25 14.246 2.25 13.5C2.25 12.754 2.937 12 4.25 12C4.552 12 4.796 12.023 5 12.056V11.75C5 11.256 4.28 11.25 4.25 11.25C3.78749 11.25 3.6007 11.3631 3.57831 11.3767C3.57688 11.3775 3.57612 11.378 3.576 11.378C3.38 11.573 3.077 11.561 2.883 11.365C2.688 11.17 2.702 10.841 2.897 10.646C2.99 10.553 3.363 10.25 4.251 10.25ZM8.33 11.611C8.117 11.877 8 12.237 8 12.625C8 13.013 8.117 13.373 8.33 13.639C8.699 14.101 9.31 13.982 9.539 13.778C9.743 13.591 10.059 13.609 10.245 13.814C10.43 14.019 10.414 14.335 10.208 14.52C9.86 14.834 9.442 15 9 15C8.445 15 7.929 14.739 7.549 14.264C7.195 13.82 7 13.239 7 12.625C7 12.011 7.195 11.429 7.549 10.986C8.233 10.134 9.422 10.02 10.209 10.73C10.414 10.915 10.431 11.231 10.246 11.436C10.06 11.64 9.744 11.658 9.54 11.472C9.311 11.266 8.701 11.147 8.33 11.611Z"/>
                            <Path Fill="{ThemeResource FindForeground}" Data="F0 M14 6C15.103 6 16 4.991 16 3.75C16 2.509 15.103 1.5 14 1.5C13.634 1.5 13.295 1.619 13 1.813V0.5C13 0.224 12.776 0 12.5 0C12.224 0 12 0.224 12 0.5V5.5C12 5.776 12.224 6 12.5 6C12.717 6 12.897 5.86 12.966 5.666C13.269 5.873 13.62 6 14 6ZM14 2.5C14.552 2.5 15 3.061 15 3.75C15 4.439 14.552 5 14 5C13.448 5 13 4.439 13 3.75C13 3.061 13.448 2.5 14 2.5Z"/>
                            <Path Fill="{ThemeResource FindForeground}" Data="F1 M1.99998 4.5C1.99998 3.673 2.67298 3 3.49998 3H5.50198C5.77798 3 6.00198 3.224 6.00198 3.5C6.00198 3.776 5.77798 4 5.50198 4H3.50198C3.22598 4 3.00198 4.225 3.00198 4.5V6.293L4.14798 5.147C4.34298 4.952 4.65998 4.952 4.85498 5.147C5.04998 5.342 5.04998 5.659 4.85498 5.854L2.85498 7.854C2.75698 7.951 2.62898 8 2.50098 8C2.37298 8 2.24498 7.952 2.14698 7.854L0.146982 5.854C-0.0480176 5.659 -0.0480176 5.342 0.146982 5.147C0.341982 4.952 0.658982 4.952 0.853982 5.147L1.99998 6.293V4.5Z"/>
                        </Canvas>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
